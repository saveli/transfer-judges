# Environment variables the pipeline reads. One entry each: what it is, default, where read.
# The four db* settings go into a dotenv file: every script that talks to the NOVA
# database calls load_dotenv('.env') (path relative to the repo root). The
# others are plain shell variables. What to edit beyond these: ml/CONFIG.md.

# --- data root ------------------------------------------------------------------------
# Root of the on-disk data: questionnaires and annotation logs under data/groundtruth,
# NOVA session folders under data/nova. Default: `data`.
# Read in ml/dsconfig.py (DATA_ROOT, GT_ROOT, NOVA_DATA); everything else imports it.
KT_DATA_ROOT=data

# --- NOVA annotation database (MongoDB, accessed through hcai-discover-utils) ----------
# Required for feature extraction and LLM judging, no default. Read via the dotenv file in
# ml/{features,llm_features,vacc_au50_remap}.py
# database host
dbHost=localhost
# database port
dbPort=27017
# database user
dbUser=
# database password
dbPassword=

# --- run switches -----------------------------------------------------------------------
# Feature-matrix directory under ml/. Default 'features'; the paper's runs use features_v2
# (predict.py setdefaults it).
# Read in ml/experiment.py, ml/features.py. Value shown: the paper's setting.
KT_FEAT_DIR=features_v2
# 1 = repair the diarised vaccines transcripts with the AU50 speaking ground truth.
# Default unset (off); the paper's feature matrices were built with 1. Read in ml/features.py.
# Value shown: the paper's setting.
KT_VACC_AU50=1
# 1 = reproduce the pre-repair (frozen) teacher target, no de-rounding. Default unset.
# Read in ml/dsconfig.py.
KT_TEACHER_LEGACY=

# --- LLM judges -------------------------------------------------------------------------
# ollama server. Default http://127.0.0.1:11434. Read by the ollama client library itself
# (ml/llm_features.py and the scripts that call it).
OLLAMA_HOST=http://127.0.0.1:11434

# --- not environment variables (hard-coded; edit the source, see ml/CONFIG.md) ----------
# NOVA annotator: 'annotator_main' for transcripts, sentiment, gaze, smile; 'system' for vaccines
#   smile (ml/features.py _annotator / SENTIMENT_SRC; ml/llm_features.py;
#   ml/vacc_au50_remap.py).
# DISCOVER extraction server: URL = https://localhost:27014/process, container data dir
#   /app/data (ml/batch_submit_jobs.py URL, DATA_CTR).
